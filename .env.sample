# Vula Control Plane — environment (copy to .env; real .env is gitignored)

# --- Server ---
PORT=3240                       # Local dev; Coolify injects its own in production
NODE_ENV=development            # production REQUIRES office creds + JWT_SECRET (boot exits otherwise)
LOG_LEVEL=info
CP_DB_PATH=./data/control-plane.db   # fallback chain: CP_DB_PATH > DB_PATH > data/control-plane.db

# --- Office admin (single account; no users table in v1) ---
OFFICE_ADMIN_EMAIL=admin@za-pos.local
OFFICE_ADMIN_PASSWORD=temp123   # dev default only — production refuses this placeholder

# The built-in mail delivery (Resend). Used when the office has no SMTP
# mailbox configured in Settings — the same arrangement optimed uses:
# one vendor, one key. Create the key at resend.com and verify the
# sending domain (vula-app.co.za) there before relying on it.
RESEND_API_KEY=
RESEND_FROM=Vula <hello@vula-app.co.za>
# Where the marketing site's quote requests are sent (default hello@).
QUOTE_TO=hello@vula-app.co.za

# --- Sessions ---
JWT_SECRET=dev-secret-change-me # production: openssl rand -base64 64
JWT_TTL_HOURS=168               # 7 days

# --- Store calls ---
STORE_REQUEST_TIMEOUT_MS=5000   # per-call timeout when pushing config / pinging stores

# --- Health sweep ---
# Probes every active store and panel on a timer, so health / version / latency on
# the fleet pages are fresh rather than as old as the last manual check. 0 disables
# the schedule (the manual POST /api/stores/health-sweep stays available).
HEALTH_SWEEP_INTERVAL_MINUTES=10

# --- Billing tick ---
# Marks lapsed invoices overdue and raises renewal invoices. Daily by default;
# 0 disables the schedule. The tick never records a settlement — only an
# explicit settlement moves a client's paid-through date.
BILLING_TICK_INTERVAL_MINUTES=1440

# --- Managed endpoints (production) ---
# The deployment domain(s) this control plane may call while holding a secret
# token, comma separated. Enforced in production only; leave empty while a
# domain is still being chosen.
MANAGED_ENDPOINT_SUFFIXES=.vula-app.co.za

# --- Reverse proxy ---
# How many proxy hops sit in front of this server (Coolify/Traefik: 1). 0 trusts
# no proxy and ignores X-Forwarded-For entirely — the safe default when the app
# is directly exposed, since the login limiter keys on the resulting address.
CP_TRUST_PROXY_HOPS=0

# --- Licence signing (asymmetric) ---
# Generate with: npx tsx scripts/generate-licence-key.ts
# The PRIVATE key stays here and must never reach a store; stores get only
# LEASE_PUBLIC_KEY. Production refuses to start without a private key, because
# a control plane that cannot sign cannot grant verifiable entitlement.
LEASE_PRIVATE_KEY=
LEASE_KEY_ID=k1
LICENCE_OFFLINE_DAYS=14         # rolling offline trade window
LICENCE_GRACE_DAYS=3            # days after paid-through before new sales stop
