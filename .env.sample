# Vula Control Plane — environment (copy to .env; real .env is gitignored)

# --- Server ---
PORT=3240                       # Local dev; Coolify injects its own in production
NODE_ENV=development            # production REQUIRES office creds + JWT_SECRET (boot exits otherwise)
LOG_LEVEL=info
CP_DB_PATH=./data/control-plane.db   # fallback chain: CP_DB_PATH > DB_PATH > data/control-plane.db

# --- Office admin (single account; no users table in v1) ---
OFFICE_ADMIN_EMAIL=admin@za-pos.local
OFFICE_ADMIN_PASSWORD=temp123   # dev default only — production refuses this placeholder

# --- Sessions ---
JWT_SECRET=dev-secret-change-me # production: openssl rand -base64 64
JWT_TTL_HOURS=168               # 7 days

# --- Store calls ---
STORE_REQUEST_TIMEOUT_MS=5000   # per-call timeout when pushing config / pinging stores

# --- Licence signing (asymmetric) ---
# Generate with: npx tsx scripts/generate-licence-key.ts
# The PRIVATE key stays here and must never reach a store; stores get only
# LEASE_PUBLIC_KEY. Production refuses to start without a private key, because
# a control plane that cannot sign cannot grant verifiable entitlement.
LEASE_PRIVATE_KEY=
LEASE_KEY_ID=k1
LICENCE_OFFLINE_DAYS=14         # rolling offline trade window
LICENCE_GRACE_DAYS=3            # days after paid-through before new sales stop
