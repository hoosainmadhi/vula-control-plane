# Vula Control Plane — environment (copy to .env; real .env is gitignored)

# --- Server ---
PORT=3240                       # Local dev; Coolify injects its own in production
NODE_ENV=development            # production REQUIRES office creds + JWT_SECRET (boot exits otherwise)
LOG_LEVEL=info
CP_DB_PATH=./data/control-plane.db   # fallback chain: CP_DB_PATH > DB_PATH > data/control-plane.db

# --- Office admin (single account; no users table in v1) ---
OFFICE_ADMIN_EMAIL=admin@za-pos.local
OFFICE_ADMIN_PASSWORD=temp123   # dev default only — production refuses this placeholder

# The built-in mail delivery (Resend). Used when the office has no SMTP
# mailbox configured in Settings — the same arrangement optimed uses:
# one vendor, one key. Create the key at resend.com and verify the
# sending domain (vula-app.co.za) there before relying on it.
RESEND_API_KEY=
RESEND_FROM=Vula <hello@vula-app.co.za>
# Where the marketing site's quote requests are sent (default hello@).
QUOTE_TO=hello@vula-app.co.za

# --- Sessions ---
JWT_SECRET=dev-secret-change-me # production: openssl rand -base64 64
JWT_TTL_HOURS=24                # office session lifetime — privileged surface, re-login daily

# --- Store calls ---
STORE_REQUEST_TIMEOUT_MS=5000   # per-call timeout when pushing config / pinging stores

# --- Health sweep ---
# Probes every active store and panel on a timer, so health / version / latency on
# the fleet pages are fresh rather than as old as the last manual check. 0 disables
# the schedule (the manual POST /api/stores/health-sweep stays available).
HEALTH_SWEEP_INTERVAL_MINUTES=10

# --- First admin while the container builds ---
# Onboarding reaches the store's admin endpoint before Coolify has finished the
# build, so the first bootstrap is usually refused. The control plane retries in
# the background and emails the credentials once it lands. 0 disables the retry
# (the reset-admin action remains the manual path).
ADMIN_PROVISION_TIMEOUT_MS=900000   # 15 minutes
ADMIN_PROVISION_INTERVAL_MS=15000   # probe every 15 seconds
# ADMIN_PROVISION_RETRY=off         # uncomment to disable the background retry

# --- Billing tick ---
# Marks lapsed invoices overdue and raises renewal invoices. Daily by default;
# 0 disables the schedule. The tick never records a settlement — only an
# explicit settlement moves a client's paid-through date.
BILLING_TICK_INTERVAL_MINUTES=1440

# --- Managed endpoints (production) ---
# The deployment domain(s) this control plane may call while holding a secret
# token, comma separated. REQUIRED in production — an empty list would let the
# control plane dial any public host it is pointed at, so boot exits without it.
MANAGED_ENDPOINT_SUFFIXES=.vula-app.co.za

# --- Reverse proxy ---
# How many proxy hops sit in front of this server (Coolify/Traefik: 1). 0 trusts
# no proxy and ignores X-Forwarded-For entirely — the safe default when the app
# is directly exposed, since the login limiter keys on the resulting address.
CP_TRUST_PROXY_HOPS=0

# --- Licence signing (asymmetric) ---
# Generate with: npx tsx scripts/generate-licence-key.ts
# The PRIVATE key stays here and must never reach a store; stores get only
# LEASE_PUBLIC_KEY. Production refuses to start without a private key, because
# a control plane that cannot sign cannot grant verifiable entitlement.
LEASE_PRIVATE_KEY=
LEASE_KEY_ID=k1
LICENCE_OFFLINE_DAYS=14         # rolling offline trade window
LICENCE_GRACE_DAYS=3            # days after paid-through before new sales stop

# --- Shared-image releases (M4) ---
# The registry image names; the digest itself comes from the release catalog,
# never from a mutable tag. Registrations are created through POST /api/releases.
VULA_STORE_IMAGE=ghcr.io/hoosainmadhi/vula-pos-store
VULA_HO_IMAGE=ghcr.io/hoosainmadhi/vula-pos-ho
# How long a release waits for the tenant's public /health before failing.
RELEASE_HEALTH_TIMEOUT_MS=480000
RELEASE_HEALTH_INTERVAL_MS=5000
# A per-tenant lock older than this is considered stale.
RELEASE_LOCK_MINUTES=30
# Comma-separated Coolify application UUIDs the release controller may modify.
# Recommend listing the Vula apps explicitly; an empty list falls back to the
# za-pos-/vula- name prefix check for local development.
VULA_ALLOWED_APP_UUIDS=
# Comma-separated office emails allowed to publish releases, apply upgrades,
# roll back or start waves. Empty in production disables all release mutations.
RELEASE_MANAGER_EMAILS=
# Label this Control Plane instance independently of its hosting mode. Set
# staging on staging-cp and production on vula-cp-prod; leave blank for the
# older VULA_STAGING_MODE behaviour.
CP_ENVIRONMENT=
# Legacy Dockerfile onboarding is opt-in and never applies to production.
# Leave false for a new installation; set true only for an explicit
# development/demo migration window.
ALLOW_LEGACY_DOCKERFILE_ONBOARDING=false

# --- Optional isolated staging boundary (M4.1) ---
# Enable only on a disposable staging Control Plane. When true:
# - app creation is refused unless the Coolify project/server/destination match
#   the values below;
# - the new app name must match one of the prefixes;
# - the domain must match the prefix + suffix;
# - every existing-app modification requires VULA_ALLOWED_APP_UUIDS.
# COOLIFY_DESTINATION_UUID is also read by the Coolify client.
VULA_STAGING_MODE=false
VULA_STAGING_PROJECT_UUID=
VULA_STAGING_SERVER_UUID=
VULA_STAGING_DESTINATION_UUID=
VULA_STAGING_APP_PREFIXES=za-pos-m4-,vula-m4-
VULA_STAGING_DOMAIN_PREFIX=m4-
VULA_STAGING_DOMAIN_SUFFIX=.vula-app.co.za
COOLIFY_DESTINATION_UUID=
