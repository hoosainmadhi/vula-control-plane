{
  "name": "za-pos-control-plane",
  "version": "1.0.0",
  "private": true,
  "description": "Vula Control Plane — office panel for the fleet of per-store Vula deployments",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,ui \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "tsx watch server.ts",
    "dev:ui": "cd frontend && npm run dev",
    "start": "node dist/server.js",
    "build": "tsc && cd frontend && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "stub": "tsx scripts/dev-store-stub.ts",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
